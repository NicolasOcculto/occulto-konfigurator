# Alle Schluessel werden ausschliesslich serverseitig gelesen (process.env in Route Handlers).
# Kein NEXT_PUBLIC_ Praefix - sonst landen sie im Browser-Bundle.

# Rueckfallebene fuer die Logo-Erkennung. Einer von beiden genuegt.
LOGO_DEV_TOKEN=
BRANDFETCH_API_KEY=

# Optional: geteilter Cache und Rate-Limit ueber alle Serverless-Instanzen hinweg.
# Ohne diese Variablen laeuft beides prozesslokal im Arbeitsspeicher.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Anfrageformular ---------------------------------------------------------
# Ohne RESEND_API_KEY antwortet /api/anfrage mit 503 und das Formular zeigt die
# Mailadresse als Rueckfallweg. Absichtlich: lieber ehrlich scheitern, als so zu
# tun, als sei die Anfrage unterwegs.
RESEND_API_KEY=

# Empfaenger der Anfragen. Ohne Angabe: nicolas.grinninger@occulto.de
ANFRAGE_EMPFAENGER=

# Absender. Resend liefert nur von einer dort freigeschalteten Domain aus.
# Der Standard onboarding@resend.dev geht nur an die Adresse des Kontoinhabers -
# fuer den Echtbetrieb occulto.de in Resend per DNS freischalten und hier
# eintragen, sonst landen die Mails im Spam oder gar nicht.
# Beispiel: Occulto B2B <b2b@occulto.de>
ANFRAGE_ABSENDER=
