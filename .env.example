# Alle Schluessel werden ausschliesslich serverseitig gelesen (process.env in Route Handlers).
# Kein NEXT_PUBLIC_ Praefix - sonst landen sie im Browser-Bundle.

# Rueckfallebene fuer die Logo-Erkennung. Einer von beiden genuegt.
LOGO_DEV_TOKEN=
BRANDFETCH_API_KEY=

# Optional: geteilter Cache und Rate-Limit ueber alle Serverless-Instanzen hinweg.
# Ohne diese Variablen laeuft beides prozesslokal im Arbeitsspeicher.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: Ziel fuer die Anfrage aus dem Formular (E-Mail-Weiterleitung o.ae.)
ANFRAGE_WEBHOOK_URL=
